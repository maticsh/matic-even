{
  "name": "@maticsh/phone",
  "version": "0.1.0",
  "description": "Phone UI parts for Even Realities G2 smart glasses apps on Even Hub: a live glasses preview, tabs, rows, buttons, a slider and a two-tap confirm, plus a dev-only remote.",
  "keywords": [
    "even-realities",
    "even-g2",
    "g2",
    "smart-glasses",
    "hud",
    "evenhub",
    "even-hub",
    "glasses-app",
    "phone-ui",
    "webview",
    "ui-components",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://even.matic.sh",
  "bugs": {
    "url": "https://github.com/maticsh/matic-even/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maticsh/matic-even.git",
    "directory": "packages/phone"
  },
  "exports": {
    ".": {
      "@maticsh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "@maticsh/source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./shell.css": {
      "@maticsh/source": "./src/shell.css",
      "default": "./dist/shell.css"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maticsh/glasses": "0.1.0"
  }
}
