{
  "name": "@maticsh/testing",
  "version": "0.1.0",
  "description": "Test tools for Even Realities G2 apps: a fake glasses bridge, an app.json lint and a URL scan that matches store review.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maticsh/matic-even.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "even-realities",
    "g2",
    "even-hub",
    "smart-glasses"
  ],
  "exports": {
    ".": {
      "@maticsh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./urls": {
      "@maticsh/source": "./src/urls.ts",
      "types": "./dist/urls.d.ts",
      "default": "./dist/urls.js"
    },
    "./dev": {
      "@maticsh/source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    }
  },
  "bin": {
    "maticsh-qr": "./dist/bin/qr.js",
    "maticsh-urls": "./dist/bin/urls.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@maticsh/glasses": "0.1.0"
  },
  "peerDependencies": {
    "@evenrealities/evenhub-cli": ">=0.1.14"
  },
  "peerDependenciesMeta": {
    "@evenrealities/evenhub-cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
