{
  "name": "@maticsh/glasses",
  "version": "0.1.0",
  "description": "Glasses-side primitives for Even Realities G2 smart glasses apps on Even Hub: input, text fitting, pages, rendering, storage, lifecycle and pixel drawing. TypeScript.",
  "keywords": [
    "even-realities",
    "even-g2",
    "g2",
    "smart-glasses",
    "hud",
    "evenhub",
    "even-hub",
    "glasses-app",
    "glasses-ui",
    "text-layout",
    "renderer",
    "pixel-font",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://even.matic.sh",
  "bugs": {
    "url": "https://github.com/maticsh/matic-even/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maticsh/matic-even.git",
    "directory": "packages/glasses"
  },
  "exports": {
    ".": {
      "@maticsh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4"
  },
  "devDependencies": {
    "@maticsh/testing": "0.1.0"
  }
}
