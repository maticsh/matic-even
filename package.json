{
  "name": "matic-even",
  "private": true,
  "description": "Open-source toolkit and field notes for building Even Realities G2 glasses apps: measured findings, glasses and phone UI, test tools, a demo app and AI skills.",
  "keywords": [
    "even-realities",
    "even-g2",
    "g2",
    "smart-glasses",
    "hud",
    "evenhub",
    "even-hub",
    "glasses-app",
    "toolkit",
    "field-notes",
    "claude-code",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://even.matic.sh",
  "bugs": {
    "url": "https://github.com/maticsh/matic-even/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "site"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build:packages",
    "build:packages": "npm run build --workspace packages",
    "pack:check": "node scripts/check-pack.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "build": "npm run build --workspaces --if-present",
    "urls": "node scripts/urls.ts apps/checklist apps/probe"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
