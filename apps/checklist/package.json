{
  "name": "checklist",
  "version": "0.1.0",
  "private": true,
  "description": "A demo G2 app on @maticsh/glasses and @maticsh/phone: three short lists, ticked from the glasses.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "evenhub-simulator http://localhost:5210",
    "qr": "node ../../scripts/qr.ts 5210",
    "pack": "npm run build && evenhub pack app.json dist -o checklist.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@maticsh/glasses": "0.1.0",
    "@maticsh/phone": "0.1.0"
  },
  "devDependencies": {
    "@maticsh/testing": "0.1.0"
  }
}
