{
  "name": "probe",
  "version": "0.1.4",
  "private": true,
  "description": "A G2 plugin that measures the glasses: display, input, sensors, lifecycle and images.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "evenhub-simulator http://localhost:5199",
    "qr": "maticsh-qr 5199",
    "urls": "maticsh-urls",
    "pack": "npm run build && evenhub pack app.json dist -o probe.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@maticsh/glasses": "0.2.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@maticsh/testing": "0.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
